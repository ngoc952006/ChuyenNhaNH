<section class="section detail-section">
    <div class="container detail-card">

        <div class="detail-visual">
            {{#if service.image}}
                <img src="{{service.image}}" alt="{{service.name}}" />
            {{else}}
                <img src="/images/service-placeholder.svg" alt="{{service.name}}" />
            {{/if}}
            <small>DỊCH VỤ CHUYỂN NHÀ NH</small>
        </div>

        <div class="detail-info">
            <span class="tag">DỊCH VỤ CHUYỂN NHÀ</span>
            <h1>{{service.name}}</h1>
            <p>{{service.description}}</p>

            <div class="detail-price">{{currency service.price}}</div>

            <ul class="check-list">
                <li>Nhân viên chuyên nghiệp</li>
                <li>Đóng gói và vận chuyển an toàn</li>
                <li>Báo giá rõ ràng, không phí ẩn</li>
                <li>Hỗ trợ đặt lịch nhanh</li>
            </ul>

            <div class="detail-actions">
                <form method="post" action="/cart/add/{{service.id}}">
                    <button class="btn btn-orange" type="submit" onclick="return confirm('Bạn có muốn thêm vào giỏ hàng không?')">🛒 Thêm vào giỏ hàng</button>
                </form>

                <a class="btn btn-outline" href="/services">← Xem dịch vụ khác</a>
            </div>
        </div>

    </div>
</section>
